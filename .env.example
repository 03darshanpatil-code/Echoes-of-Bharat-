# Copy to .env if you use a dotenv loader, or just export these in your shell.
# Every value has a safe default — you can run `npm start` without any of them.

# HTTP port for the API + dashboard (default: 3000)
PORT=3000

# SQLite database file (default: ./data/echoes.db)
# Use :memory: for a throwaway database (the automated tests do this).
DB_PATH=./data/echoes.db

# Set to 0 to silence the per-request log lines.
LOG_REQUESTS=1
